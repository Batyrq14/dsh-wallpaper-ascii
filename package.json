{
  "name": "dsh-nocturne-wallpaper",
  "version": "0.2.0",
  "description": "A living, full-screen ASCII wallpaper for DeepSeek Harness — five looping scenes with an appearance panel, rendered behind the chat.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/preview.png",
    "docs/preview-panel.png",
    "docs/preview-moonlit.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "wallpaper",
    "background",
    "ascii",
    "ambient"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Batyrq14/dsh-wallpaper-ascii.git"
  },
  "homepage": "https://github.com/Batyrq14/dsh-wallpaper-ascii#readme",
  "bugs": {
    "url": "https://github.com/Batyrq14/dsh-wallpaper-ascii/issues"
  }
}
